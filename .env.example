# Firebase Authentication config (optional — leave blank to use built-in local auth)
# Get these values from Firebase Console > Project Settings > General
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Set to "firebase" to use Firebase Auth, or "local" to use the built-in
# browser-only auth (default). Local auth never leaves the device and is
# fine for a student prototype / offline demo.
VITE_AUTH_PROVIDER=local
